// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/universal
{
	"name": "Default Linux Universal",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/universal:2-linux",
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1": {},
		"ghcr.io/devcontainers/features/azure-cli:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-azuretools.vscode-docker",
				"mindaro.mindaro",
				"ms-kubernetes-tools.vscode-aks-tools",
				"GitHub.copilot",
				"ms-azuretools.vscode-azure-github-copilot",
				"GitHub.copilot-workspace",
				"ms-vscode.vscode-copilot-vision",
				"ms-vscode.vscode-websearchforcopilot",
				"ms-vscode.copilot-mermaid-diagram",
				"ms-python.isort",
				"ms-azuretools.azure-dev",
				"ms-windows-ai-studio.windows-ai-studio",
				"MS-CST-E.vscode-devskim",
				"ms-python.vscode-python-envs",
				"GitHub.copilot-chat",
				"ms-azuretools.vscode-bicep"
			]
		}
	},
	"secrets": {
		"service_bus_namespace": {
			"description": "Fully qualified namespace for Azure Service Bus."
		},
		"finalize_content_queue": {
			"description": "Name of the queue for finalizing content processing."
		},
		"video_summary_queue": {
			"description": "Name of the queue for video summary tasks."
		},
		"cognitive_services_endpoint": {
			"description": "Endpoint URL for Azure Cognitive Services API."
		},
		"azure_openai_endpoint": {
			"description": "Endpoint URL for Azure OpenAI Service."
		},
		"azure_openai_api_version": {
			"description": "API version for Azure OpenAI Service."
		},
		"azure_openai_model_name": {
			"description": "Name of the model used in Azure OpenAI Service."
		},
		"content_understanding_endpoint": {
			"description": "Endpoint URL for the Content Understanding API."
		},
		"content_understanding_api_version": {
			"description": "API version for the Content Understanding API."
		},
		"content_understanding_key": {
			"description": "Subscription key for authenticating with the Content Understanding API."
		},
		"video_analyzer_name": {
			"description": "Name of the video analyzer used for processing videos."
		},
		"storage_account_name": {
			"description": "Azure Storage account name where blobs are stored."
		},
		"storage_container_name": {
			"description": "Name of the container within the Azure Storage account."
		},
		"index_file_queue": {
			"description": "Name of the queue for index files."
		},
		"host": {
			"description": "Host address for the API server. Defaults to 0.0.0.0."
		},
		"port": {
			"description": "Port number for the API server. Defaults to 8000."
		},
		"index_blob_queue": {
			"description": "Name of the queue for indexing blobs."
		},
		"mp4_output_path": {
			"description": "Filesystem path where MP4 output files will be stored."
		},
		"logging_level": {
			"description": "Optional logging level (e.g., DEBUG, INFO). Defaults to ERROR."
		}
	}
}
